approval_settings.json
distiller_state.json
research_queue.json
self_modify_log.json
_test_workspace/

# Runtime state that WAS tracked (an ignore rule does not untrack an already
# tracked file — these needed an explicit `git rm --cached`). They carry local
# activity data and made `git status` permanently dirty.
computer_action_log.json
notes.json
predictive_metrics.json
proactive_state.json
proactive_suggestions.json

